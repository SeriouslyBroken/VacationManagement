<Activity mc:Ignorable="sap sap2010" x:Class="ManagerReview"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib"
  xmlns:sd="clr-namespace:System.Data;assembly=System.Data.Common"
  xmlns:ue="clr-namespace:UiPath.Excel.Activities;assembly=UiPath.Excel.Activities"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════
       ARGUMENTS (In)
       ═══════════════════════════════════════════════ -->
  <x:Members>
    <x:Property Name="in_EmployeeID"  Type="InArgument(x:String)" />
    <x:Property Name="in_StartDate"   Type="InArgument(s:DateTime)" />
    <x:Property Name="in_EndDate"     Type="InArgument(s:DateTime)" />
    <x:Property Name="in_IsConflict"  Type="InArgument(x:Boolean)" />
  </x:Members>

  <VisualBasic.Settings>
    <x:Null />
  </VisualBasic.Settings>

  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>System.Activities.Expressions</x:String>
      <x:String>System.Activities.Validation</x:String>
      <x:String>System.Activities.XamlIntegration</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>Microsoft.VisualBasic.Activities</x:String>
      <x:String>System</x:String>
      <x:String>System.Collections</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Collections.ObjectModel</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Diagnostics</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Net.Mail</x:String>
      <x:String>System.Xml</x:String>
      <x:String>System.Xml.Linq</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>System.Windows.Markup</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>

  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>System.ComponentModel.TypeConverter</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Data.Common</AssemblyReference>
      <AssemblyReference>System.Linq</AssemblyReference>
      <AssemblyReference>System.Net.Mail</AssemblyReference>
      <AssemblyReference>System.ObjectModel</AssemblyReference>
      <AssemblyReference>System.Private.CoreLib</AssemblyReference>
      <AssemblyReference>System.Xaml</AssemblyReference>
      <AssemblyReference>System.Xml</AssemblyReference>
      <AssemblyReference>System.Xml.Linq</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Excel.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Studio.Constants</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>

  <!-- ═══════════════════════════════════════════════
       SÉQUENCE PRINCIPALE
       ═══════════════════════════════════════════════ -->
  <Sequence DisplayName="ManagerReview" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="dt_Log" />
      <Variable x:TypeArguments="x:Int32"      Name="int_RowIndex" />
      <Variable x:TypeArguments="x:String"     Name="str_CurrentStatus" Default="Pending" />
      <Variable x:TypeArguments="sd:DataTable" Name="dt_StatusCheck" />
    </Sequence.Variables>

    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>

    <!-- ──────────────────────────────────────────────
         ÉTAPE 1 — Read Range : charger MasterLog complet → dt_Log
         AddHeaders=True : ligne 1 (header) consommée, Rows.Count = lignes de données
         ────────────────────────────────────────────── -->
    <ue:ReadRange DisplayName="Read Range — MasterLog → dt_Log"
      WorkbookPath="[&quot;VacationDatabase.xlsx&quot;]"
      SheetName="[&quot;MasterLog&quot;]"
      Range="[&quot;&quot;]"
      AddHeaders="True"
      DataTable="[dt_Log]"
      sap2010:WorkflowViewState.IdRef="ReadRange_1" />

    <!-- ──────────────────────────────────────────────
         ÉTAPE 2 — Assign : calculer la prochaine ligne libre
         +2 car : ligne 1 = header (consommé par AddHeaders), index base-1
         ────────────────────────────────────────────── -->
    <Assign DisplayName="Assign — int_RowIndex = dt_Log.Rows.Count + 2"
      sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[int_RowIndex]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">[dt_Log.Rows.Count + 2]</InArgument>
      </Assign.Value>
    </Assign>

    <!-- ──────────────────────────────────────────────
         ÉTAPE 3 — Write Cell ×5 : écrire la demande en statut Pending
         ────────────────────────────────────────────── -->

    <!-- Colonne A : EmployeeID -->
    <ue:WriteCell DisplayName="Write Cell — A : EmployeeID"
      WorkbookPath="[&quot;VacationDatabase.xlsx&quot;]"
      SheetName="[&quot;MasterLog&quot;]"
      Cell="[&quot;A&quot; &amp; int_RowIndex.ToString()]"
      Text="[in_EmployeeID]"
      sap2010:WorkflowViewState.IdRef="WriteCell_1" />

    <!-- Colonne B : StartDate -->
    <ue:WriteCell DisplayName="Write Cell — B : StartDate"
      WorkbookPath="[&quot;VacationDatabase.xlsx&quot;]"
      SheetName="[&quot;MasterLog&quot;]"
      Cell="[&quot;B&quot; &amp; int_RowIndex.ToString()]"
      Text="[in_StartDate.ToString(&quot;dd/MM/yyyy&quot;)]"
      sap2010:WorkflowViewState.IdRef="WriteCell_2" />

    <!-- Colonne C : EndDate -->
    <ue:WriteCell DisplayName="Write Cell — C : EndDate"
      WorkbookPath="[&quot;VacationDatabase.xlsx&quot;]"
      SheetName="[&quot;MasterLog&quot;]"
      Cell="[&quot;C&quot; &amp; int_RowIndex.ToString()]"
      Text="[in_EndDate.ToString(&quot;dd/MM/yyyy&quot;)]"
      sap2010:WorkflowViewState.IdRef="WriteCell_3" />

    <!-- Colonne D : Status = "Pending" -->
    <ue:WriteCell DisplayName="Write Cell — D : Status = Pending"
      WorkbookPath="[&quot;VacationDatabase.xlsx&quot;]"
      SheetName="[&quot;MasterLog&quot;]"
      Cell="[&quot;D&quot; &amp; int_RowIndex.ToString()]"
      Text="[&quot;Pending&quot;]"
      sap2010:WorkflowViewState.IdRef="WriteCell_4" />

    <!-- Colonne E : Timestamp -->
    <ue:WriteCell DisplayName="Write Cell — E : Timestamp"
      WorkbookPath="[&quot;VacationDatabase.xlsx&quot;]"
      SheetName="[&quot;MasterLog&quot;]"
      Cell="[&quot;E&quot; &amp; int_RowIndex.ToString()]"
      Text="[Now.ToString(&quot;dd/MM/yyyy HH:mm:ss&quot;)]"
      sap2010:WorkflowViewState.IdRef="WriteCell_5" />

    <!-- ──────────────────────────────────────────────
         ÉTAPE 4 — Send Outlook Mail Message (Manager)
         → placeholder LogMessage ; remplacer par Send Mail quand SMTP configuré
         ────────────────────────────────────────────── -->
    <ui:LogMessage DisplayName="[MAIL MANAGER] Vacation Request Pending"
      Level="Info"
      Message="[&quot;TO: manager@test.com | SUBJECT: Vacation Request Pending - &quot; &amp; in_EmployeeID &amp; &quot; | BODY: Employee &quot; &amp; in_EmployeeID &amp; &quot; requested vacation from &quot; &amp; in_StartDate.ToString(&quot;dd/MM/yyyy&quot;) &amp; &quot; to &quot; &amp; in_EndDate.ToString(&quot;dd/MM/yyyy&quot;) &amp; &quot;. Please update the status in Excel.&quot;]"
      sap2010:WorkflowViewState.IdRef="LogMessage_1" />

    <!-- ──────────────────────────────────────────────
         ÉTAPE 5 — While : boucle de polling (10 s) jusqu'à décision manager
         Condition : str_CurrentStatus = "Pending"
         ────────────────────────────────────────────── -->
    <While DisplayName="While — Polling décision manager (10s)"
      Condition="[str_CurrentStatus = &quot;Pending&quot;]"
      sap2010:WorkflowViewState.IdRef="While_1">
      <While.Body>
        <Sequence DisplayName="Polling Iteration"
          sap2010:WorkflowViewState.IdRef="Sequence_2">
          <sap:WorkflowViewStateService.ViewState>
            <scg:Dictionary x:TypeArguments="x:String, x:Object">
              <x:Boolean x:Key="IsExpanded">True</x:Boolean>
            </scg:Dictionary>
          </sap:WorkflowViewStateService.ViewState>

          <!-- ÉTAPE 6 — Delay 10 secondes -->
          <Delay DisplayName="Delay — 10 secondes"
            Duration="[System.TimeSpan.FromSeconds(10)]"
            sap2010:WorkflowViewState.IdRef="Delay_1" />

          <!-- ÉTAPE 7 — Read Range : relire la cellule D (Status)
               AddHeaders=False : la valeur de la cellule → Rows(0)(0) -->
          <ue:ReadRange DisplayName="Read Range — Cellule D (Status) → dt_StatusCheck"
            WorkbookPath="[&quot;VacationDatabase.xlsx&quot;]"
            SheetName="[&quot;MasterLog&quot;]"
            Range="[&quot;D&quot; &amp; int_RowIndex.ToString()]"
            AddHeaders="False"
            DataTable="[dt_StatusCheck]"
            sap2010:WorkflowViewState.IdRef="ReadRange_2" />

          <!-- ÉTAPE 8 — Assign : mettre à jour la variable de contrôle -->
          <Assign DisplayName="Assign — str_CurrentStatus = valeur lue"
            sap2010:WorkflowViewState.IdRef="Assign_2">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[str_CurrentStatus]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[dt_StatusCheck.Rows(0)(0).ToString()]</InArgument>
            </Assign.Value>
          </Assign>

        </Sequence>
      </While.Body>
    </While>

    <!-- ──────────────────────────────────────────────
         ÉTAPE 9 — If : décision finale Approved / Denied
         → Send Outlook Mail Message à l'employé
         ────────────────────────────────────────────── -->
    <If DisplayName="If — Approved ou Denied ?"
      Condition="[str_CurrentStatus = &quot;Approved&quot;]"
      sap2010:WorkflowViewState.IdRef="If_1">

      <If.Then>
        <!-- THEN : demande approuvée -->
        <ui:LogMessage DisplayName="[MAIL EMPLOYÉ] Vacation Request Approved"
          Level="Info"
          Message="[&quot;TO: &quot; &amp; in_EmployeeID &amp; &quot;@test.com | SUBJECT: Vacation Request Approved | BODY: Hello &quot; &amp; in_EmployeeID &amp; &quot;, your vacation request has been approved.&quot;]"
          sap2010:WorkflowViewState.IdRef="LogMessage_2" />
      </If.Then>

      <If.Else>
        <!-- ELSE : demande refusée -->
        <ui:LogMessage DisplayName="[MAIL EMPLOYÉ] Vacation Request Denied"
          Level="Warn"
          Message="[&quot;TO: &quot; &amp; in_EmployeeID &amp; &quot;@test.com | SUBJECT: Vacation Request Denied | BODY: Hello &quot; &amp; in_EmployeeID &amp; &quot;, your vacation request has been denied.&quot;]"
          sap2010:WorkflowViewState.IdRef="LogMessage_3" />
      </If.Else>

    </If>

  </Sequence>
</Activity>
